# SRRIS Backend — Environment Variables Template
# Copy this file to .env before starting the server.
# Never commit the actual .env to version control.

# ── Google Gemini Vision API (required for multimodal radiology analysis) ──────
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ── JWT Authentication Secret (required for doctor login) ──────────────────────
# Generate a strong random string: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=super_secret_jwt_key_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Database (optional — default is SQLite at backend/srris_production_v5.db) ──
# Uncomment and set for PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/srris

# ── Server (optional) ──────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
SRRIS_DEV=true

# ── CORS Origins (comma-separated origins allowed in production) ───────────────
# CORS_ORIGINS=https://dashboard.srris-hospital.com,http://localhost:3000

